# Backend
backend/venv/
backend/.venv/
backend/__pycache__/
backend/**/__pycache__/

# Frontend
frontend/node_modules/
frontend/dist/

# Environment files may contain credentials. Keep only example templates.
.env
.env.*
!.env.example
!**/.env.example
!**/.env.production.example

# Local data and generated files
backend/db.sqlite3
backend/staticfiles/
backend/media/
.DS_Store

# Test / lint artifacts
backend/.coverage
backend/coverage.xml
backend/htmlcov/
backend/.ruff_cache/
frontend/coverage/
frontend/test-results/
frontend/playwright-report/
.pytest_cache/

# Filled-in production secrets (templates stay tracked)
backend/.env.production
backend/.env.production.local
