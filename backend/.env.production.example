# Production environment template for the Tunmis Closet API.
#
# Copy this file to .env.production ONLY for a self-hosted production check,
# or, preferably, enter these values in your host's dashboard (Render/Railway
# environment variables). Never commit a filled-in copy.
#
#   cp .env.production.example .env.production
#
# Startup fails fast (config.settings._validate_production_settings) if any
# required production value is missing or unsafe.

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
DEBUG=False

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
# Must be unique, at least 50 characters, and must not contain placeholders.
SECRET_KEY=

# Public API hostname(s). Render also injects RENDER_EXTERNAL_HOSTNAME, which
# is appended automatically. Do not use "*".
ALLOWED_HOSTS=api.tunmiscloset.com

# Use a less predictable Django admin path.
ADMIN_URL=studio-admin/

# ---------------------------------------------------------------------------
# Database (PostgreSQL is required when DEBUG=False)
# ---------------------------------------------------------------------------
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/tunmis_closet

# ---------------------------------------------------------------------------
# Frontend origin (must be the public HTTPS storefront)
# ---------------------------------------------------------------------------
FRONTEND_URL=https://www.tunmiscloset.com
CORS_ALLOWED_ORIGINS=https://www.tunmiscloset.com
CSRF_TRUSTED_ORIGINS=https://www.tunmiscloset.com

# ---------------------------------------------------------------------------
# Media (Cloudinary)
# ---------------------------------------------------------------------------
# Set USE_CLOUDINARY=False + ALLOW_LOCAL_MEDIA=True only on a host that
# persists and serves /media/ through a web server.
USE_CLOUDINARY=True
ALLOW_LOCAL_MEDIA=False
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------------------------------------------------------------------------
# Paystack (customer-facing production must use the live key pair)
# ---------------------------------------------------------------------------
PAYSTACK_SECRET_KEY=sk_live_
PAYSTACK_PUBLIC_KEY=pk_live_
PAYSTACK_MODE=live
# Must stay False for customer-facing production. Test keys are rejected
# unless this is explicitly True for a separate staging deployment.
ALLOW_TEST_PAYMENTS=False

# ---------------------------------------------------------------------------
# Email (Brevo / any SMTP provider)
# EMAIL_HOST_USER is Brevo's SMTP "Login" (often <ID>@smtp-brevo.com), not the
# account email. If Brevo IP restrictions are on, allow the server's egress IP
# (or disable the restriction); Render's default outbound IPs are not static.
# ---------------------------------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_HOST_USER=ab595f001@smtp-brevo.com
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=15
DEFAULT_FROM_EMAIL=no-reply@tunmiscloset.com
CONTACT_EMAIL=hello@tunmiscloset.com
REQUIRE_EMAIL_VERIFICATION=True
PASSWORD_RESET_TIMEOUT=3600
EMAIL_VERIFICATION_TIMEOUT=259200

# ---------------------------------------------------------------------------
# Security (defaults are already safe when DEBUG=False; override only if needed)
# ---------------------------------------------------------------------------
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Optional error tracking (Sentry). Leave empty to disable.
# ---------------------------------------------------------------------------
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.0
