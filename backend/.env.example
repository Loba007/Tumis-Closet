# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real secrets.

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
# Production requires at least 50 characters and rejects placeholder values.
SECRET_KEY=change-this-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Leave DATABASE_URL empty to use local SQLite. Production requires PostgreSQL:
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/tunmis_closet
DATABASE_URL=

# Media storage. In production set USE_CLOUDINARY=True, or explicitly opt in
# to local media with ALLOW_LOCAL_MEDIA=True (only if a web server serves it).
USE_CLOUDINARY=False
ALLOW_LOCAL_MEDIA=False
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Paystack — create your own keys at
# https://dashboard.paystack.com/#/settings/developer
# Never commit real keys. Rotate any key that has been shared publicly.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_MODE=test
# Keep test payments disabled on customer-facing production deployments.
# Set True only for a separately identified staging/test deployment with DEBUG=False.
ALLOW_TEST_PAYMENTS=False

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173

# Optional: change the Django admin path (default: admin/).
# ADMIN_URL=studio-admin/

# Email — the console backend prints emails locally. Production requires SMTP
# unless ALLOW_CONSOLE_EMAIL=True is explicitly set.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# EMAIL_USE_SSL=False
# EMAIL_TIMEOUT=15
DEFAULT_FROM_EMAIL=no-reply@tunmiscloset.com
CONTACT_EMAIL=hello@tunmiscloset.com
# REQUIRE_EMAIL_VERIFICATION=True
# PASSWORD_RESET_TIMEOUT=3600
# EMAIL_VERIFICATION_TIMEOUT=259200

# Production security — leave these unset locally.
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# SECURE_HSTS_SECONDS=31536000
# LOG_LEVEL=INFO
